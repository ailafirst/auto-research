# Private runtime settings. This file is copied to deployment/runtime/secrets.env
# and is ignored by Git. Replace every REPLACE_* value locally.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=REPLACE_LLM_API_KEY
LLM_BASE_URL=

USE_TAVILY=true
TAVILY_API_KEY=REPLACE_TAVILY_API_KEY

APP_ENV=production
REDIS_URL=redis://127.0.0.1:6379/0
MODEL_SERVICE_URL=http://127.0.0.1:8100
QUEUE_ENABLED=true
SECRET_KEY=REPLACE_RANDOM_SECRET
