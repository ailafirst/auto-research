# 容器编排的部署参数。
#
# 一般不需要手动建：deployment/start-all.ps1 首次运行时会自动生成同目录的 .env，
# 并为下面四个口令各写入一串 32~40 位随机值。想手动准备时再复制本文件：
#
#     cp deployment/docker/.env.example deployment/docker/.env
#
# 这一份只放「部署形态」参数。应用的私有配置（LLM_API_KEY / TAVILY_API_KEY 等）
# 仍在项目根目录的 .env，由 compose 的 env_file 注入容器。
# 本文件同目录的 .env 已被 .gitignore 忽略，可以安全填入口令。

# Web 入口端口。公网隧道 frpc 转发的是 127.0.0.1:80，所以对外服务时应保持 80；
# 想与宿主机上别的服务并存时改成 8080 之类即可。
WEB_PORT=80

# worker 副本数。也可以临时用 docker compose up -d --scale worker=4 覆盖。
WORKER_REPLICAS=2

# ── 基础设施口令 ──────────────────────────────────────────────────────────────
# 四项都没有默认值：compose 里写的是 ${VAR:?...}，缺任何一个都会直接启动失败，
# 而不是悄悄退回一个人人都知道的弱口令。请填随机值，不要照抄本文件。
#
# MySQL 的两个口令只在数据卷首次初始化时生效；卷已存在时改这里不改变数据库里的
# 实际口令，轮换必须走 ALTER USER，见 README「凭据轮换」。
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Redis 同时承载 arq 队列、embedding 缓存和限流计数，默认无鉴权，必须设。
REDIS_PASSWORD=
# Qdrant 默认无鉴权，任何连得上的进程都能读写乃至删除整个集合。
QDRANT_API_KEY=

# ── /health 明细令牌 ──────────────────────────────────────────────────────────
# /health 经 Nginx 公网可达。留空（或不填）时任何调用方都只看得到「哪一项坏了」；
# 填了值以后，带 `X-Health-Token: <值>` 的请求才能拿到 dependencies[].detail
# （内部主机名、端口、库用户名、组件版本、失败时的异常原文）。
# start-all.ps1 会自动生成，并在启动校验时自己带上这个头。
HEALTH_DETAIL_TOKEN=

# ── 宿主机侧的调试端口 ────────────────────────────────────────────────────────
# 均只绑 127.0.0.1：容器之间走服务名通信，这些映射仅供本机排查与数据迁移。
# 不写 127.0.0.1 的话 Docker 会绑 0.0.0.0，把三个基础设施直接暴露到局域网。
MYSQL_PORT=3307
REDIS_PORT=6380
QDRANT_PORT=6334
