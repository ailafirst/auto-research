# ============================================
# Deep Research Agent - Environment Variables
# ============================================

# --- LLM Configuration ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=
LLM_MAX_TOKENS=16384
LLM_TEMPERATURE=0.3
# 生产：进程级全局 LLM 并发闸门（实测 mimo 后端安全上限）
LLM_MAX_CONCURRENCY=12
# 生产：各节点内子问题并发数
ANALYST_CONCURRENCY=8
FACT_CHECKER_CONCURRENCY=5
# Benchmark 专用总 LLM 预算（pipeline + RAGAS 共享，比生产略保守）
LLM_BENCHMARK_CONCURRENCY=10

# --- Search Configuration ---
# USE_TAVILY=true → Tavily（推荐），false → DuckDuckGo（免费，无需 key）
USE_TAVILY=true
TAVILY_API_KEY=your_tavily_key_here
SERPER_API_KEY=your_serper_key_here
BING_API_KEY=your_bing_key_here
MAX_SEARCH_RESULTS=5
# 学术源双路（方案①）：每次查询额外并发一路限定学术白名单域的 Tavily 检索并合并，
# 让研究/综述源进入候选池（相关性交给 reranker 自过滤，统一生效不猜问题类型）。
# 仅 Tavily 生效；每查询多 ~1× Tavily credit。详见 docs/证据信源质量改进方案.md
ACADEMIC_SEARCH_ENABLED=true

# --- Qdrant 向量库 ---
# memory = 进程内实例，零基础设施，单机开发够用（默认）
# remote = 连 QDRANT_URL 指向的服务，向量持久化并跨进程共享
# 注意：只填 QDRANT_URL 不改 QDRANT_MODE 是没用的，仍然走内存模式。
# 容器化部署由 compose 直接注入 remote，这里不必改。实际生效的模式见 /health。
QDRANT_MODE=memory
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=deep_research_chunks
# 证据向量保留天数（0=不清理）。remote 模式下向量会一直累积（单任务约 2000 chunk），
# worker 每天 VECTOR_CLEANUP_HOUR 点（UTC）跑一次范围删除。memory 模式下该配置无效。
VECTOR_TTL_DAYS=7
VECTOR_CLEANUP_HOUR=3

# --- RAG Configuration ---
# EMBEDDING_PROVIDER=st          → sentence-transformers + GPU（推荐，需 CUDA）
# EMBEDDING_PROVIDER=fastembed   → 本地 fastembed 模型（CPU ONNX，轻量无需 GPU）
# EMBEDDING_PROVIDER=api         → 通过 LiteLLM 调用 API（复用 LLM_API_KEY）
EMBEDDING_PROVIDER=st
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
CHUNK_SIZE=800
CHUNK_OVERLAP=200
RAG_TOP_K=6
# 本地模型推理精度（仅 cuda 生效；cpu 下自动退回 fp32）。
# 120 题黄金集实测 fp16 vs fp32：Recall@6 0.8917→0.9000、Recall@40 持平、
# NDCG@6 -0.003（均在噪声内），显存 4332→2166 MB、embed 快 2.7×。
# 复现：python rag_experiments/experiment_fp16.py --both --save
MODEL_DTYPE=fp16
# CrossEncoder Reranker（需 sentence-transformers，GPU 推荐）
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_K=6
RERANKER_RETRIEVE_K=40
# 跨语言双路检索：中文 query 经本地 MT 译写为英文，中英双路各检索后合并最高分
# 解决"中文问题→英文 gold"的 dense 跨语言对齐失效（基准实测 Recall@6 +3.4pp）
XLING_ENABLED=true
TRANSLATION_MODEL=Helsinki-NLP/opus-mt-zh-en

# --- 模型服务化（可选，但容器化部署下必填）---
# 非空时 API/worker 全程经 HTTP 调用模型服务，进程内不 import torch
# （实测每 worker commit 6.9GB→0.75GB）。为空则各进程本地加载模型。
# 容器镜像刻意不含 torch，所以容器化部署下这条不通 = 研究任务必然失败，
# 不再是「变慢」。compose 已注入 http://host.docker.internal:8100，这里不必改。
# 启动模型服务：deployment\start-all.ps1（内部即 uvicorn app.model_server:app --port 8100）
MODEL_SERVICE_URL=
MODEL_SERVICE_TIMEOUT=30

# --- 任务队列（arq，多 worker）---
# true=入 arq 队列由独立 worker 执行（需另起 `arq app.worker.WorkerSettings`）；
# 队列不可用时自动回退进程内执行（单机开发无需 worker）
QUEUE_ENABLED=true
WORKER_MAX_JOBS=4
JOB_TIMEOUT=1800

# --- 持久化（关系型 SoR）---
# 默认 SQLite（零基础设施）。多机部署时切 MySQL：mysql+aiomysql://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///output/deepresearch.db

# --- 分布式限流（Redis 令牌桶，多 worker 全局速率上限）---
# Redis 不可用时自动退回进程内 asyncio.Semaphore（降级安全）
LLM_RATE_LIMIT_ENABLED=true
LLM_RATE_LIMIT_PER_SEC=12
LLM_RATE_BURST=12

# --- Cache (Redis) ---
# REDIS_URL 为空 → 缓存禁用（服务照常运行，只是不走缓存）。
# 启用后口令要写进 URL：redis://:<REDIS_PASSWORD>@localhost:6379/0
# 容器化部署由 compose 注入（口令见 deployment/docker/.env），这里不必改。
REDIS_URL=
CACHE_ENABLED=true
CACHE_VERSION=v1
SEARCH_CACHE_TTL=21600
EMB_CACHE_TTL=2592000

# --- App Configuration ---
APP_ENV=development
LOG_LEVEL=INFO
MAX_ROUNDS=2
REQUEST_TIMEOUT=30
MAX_CONCURRENT_FETCHES=5
MAX_SOURCES_PER_ROUND=20

# --- /health 明细令牌 ---
# /health 经 Nginx 公网可达。留空（默认）时任何调用方都只能看到「哪一项依赖坏了」；
# 填了值以后，带 `X-Health-Token: <值>` 的请求才能拿到 dependencies[].detail
# ——里面是内部主机名、端口、数据库用户名、组件版本号和失败时的异常原文。
# 容器化部署由 compose 从 deployment/docker/.env 注入（start-all.ps1 自动生成），
# 这里不必改。开发模式下留空即可，排查看控制台日志。
HEALTH_DETAIL_TOKEN=

# --- GitHub ---
GITHUB_TOKEN=your_github_pat_here
